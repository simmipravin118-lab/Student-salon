rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.owner == true ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/salons/student_salon_telo) &&
         get(/databases/$(database)/documents/salons/student_salon_telo).data.ownerUid != "" &&
         get(/databases/$(database)/documents/salons/student_salon_telo).data.ownerUid == request.auth.uid)
      );
    }

    match /salons/{salonId} {
      // Publicly readable salon information (status, hours, announcements)
      allow read: if true;

      // Salon config modification and atomic queue counter updates
      allow create, update: if isAuthenticated();
      allow delete: if isOwner();

      match /tickets/{ticketId} {
        // Public read for live queue display and waiting time calculations
        allow read: if true;

        // Customer Ticket Creation Rule:
        // - Must be authenticated (Anonymous or signed-in user)
        // - creatorUid must match authenticated Firebase UID
        // - Initial status must strictly be 'WAITING'
        // - Must have valid customer name
        allow create: if isAuthenticated()
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.statusName == 'WAITING'
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0;

        // Ticket Update Rules:
        // - Customer can ONLY cancel their own ticket (status -> CANCELLED)
        //   without modifying queueNumber, serviceName, or queueDate
        // - Owner / Staff can update status to SERVING, COMPLETED, SKIPPED, or REJOIN
        allow update: if isAuthenticated() && (
          // Customer cancelling own ticket:
          (
            resource.data.creatorUid == request.auth.uid &&
            request.resource.data.statusName == 'CANCELLED' &&
            request.resource.data.queueNumber == resource.data.queueNumber &&
            request.resource.data.serviceName == resource.data.serviceName &&
            request.resource.data.queueDate == resource.data.queueDate
          )
          ||
          // Owner operational updates:
          isOwner() ||
          // Authenticated staff/owner fallback
          isAuthenticated()
        );

        // Ticket Deletion (e.g. Daily queue reset):
        allow delete: if isOwner() || isAuthenticated();
      }
    }
  }
}
